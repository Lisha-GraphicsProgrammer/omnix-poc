[
  {
    "alert_id": "no_helmet_detection",
    "description": "Alert when a worker is detected without a helmet",
    "trigger": {
      "zone": "entire_site",
      "condition": {
        "detect": "person",
        "missing": "helmet",
        "proximity": "within_zone"
      }
    },
    "detection": {
      "required_classes": ["person", "helmet"],
      "logic": {
        "type": "absence_in_association",
        "rule": "person_detected AND NOT helmet_near_person"
      },
      "association": {
        "method": "bounding_box_overlap_or_proximity",
        "iou_threshold": 0.1,
        "proximity_px": 60
      }
    },
    "zone_definition": {
      "name": "entire_site",
      "type": "full_frame"
    },
    "tracking": {
      "enabled": true,
      "algorithm": "bytetrack",
      "min_confidence": 0.5
    },
    "alert_action": {
      "type": "alert",
      "severity": "high",
      "message": "Worker detected without helmet on construction site",
      "cooldown_seconds": 5,
      "include_snapshot": true
    }
  },
  {
    "alert_id": "worker_count_exceeded",
    "description": "Count workers on site and alert if more than 10 are present simultaneously",
    "trigger": {
      "zone": "entire_site",
      "condition": {
        "detect": "person",
        "aggregation": "count",
        "operator": "greater_than",
        "threshold": 10,
        "evaluation": "simultaneous"
      }
    },
    "detection": {
      "required_classes": ["person"],
      "logic": {
        "type": "count_in_zone",
        "rule": "COUNT(person_within_zone) > 10"
      },
      "counting": {
        "method": "unique_tracked_ids_in_zone",
        "deduplicate": true,
        "min_confidence": 0.5,
        "min_frames_visible": 3
      }
    },
    "zone_definition": {
      "name": "entire_site",
      "type": "full_frame"
    },
    "tracking": {
      "enabled": true,
      "algorithm": "bytetrack",
      "persist_ids": true
    },
    "evaluation": {
      "mode": "per_frame",
      "export_live_count": true,
      "count_reset": "when_below_threshold"
    },
    "alert_action": {
      "type": "alert",
      "severity": "medium",
      "message": "Worker count exceeded: more than 10 workers currently on site",
      "cooldown_seconds": 15,
      "include_count_in_message": true
    }
  },
  {
    "alert_id": "vehicle_worker_proximity",
    "description": "Alert when any vehicle comes within 10 meters of a worker",
    "trigger": {
      "zone": "entire_site",
      "condition": {
        "detect": ["car", "truck"],
        "proximity_to": "person",
        "operator": "less_than",
        "distance_meters": 10
      }
    },
    "detection": {
      "required_classes": ["person", "car", "truck"],
      "logic": {
        "type": "cross_class_proximity",
        "rule": "DISTANCE(vehicle, person) < 10 meters"
      },
      "proximity": {
        "method": "real_world_distance_estimation",
        "reference_calibration": "user_defined_ground_plane",
        "fallback_method": "bounding_box_proximity_px",
        "distance_meters": 10,
        "vehicle_classes": ["car", "truck"],
        "person_class": "person"
      }
    },
    "zone_definition": {
      "name": "entire_site",
      "type": "full_frame"
    },
    "tracking": {
      "enabled": true,
      "algorithm": "bytetrack",
      "persist_ids": true,
      "min_confidence": 0.5
    },
    "evaluation": {
      "mode": "per_frame",
      "pair_tracking": true,
      "suppress_duplicate_pairs_seconds": 5
    },
    "alert_action": {
      "type": "alert",
      "severity": "critical",
      "message": "Vehicle within 10 meters of a worker detected on construction site",
      "cooldown_seconds": 3,
      "include_snapshot": true,
      "include_involved_ids": true
    }
  }
]