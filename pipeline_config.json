{
  "pipeline_id": "auto_forklift_worker__fire_detection",
  "description": "Forklift detected near worker + Fire detected on site",
  "models": {
    "forklift": "runs/detect/forklift_model/weights/best.pt",
    "fire": "runs/detect/fire_model/weights/best.pt"
  },
  "zones": [
    {
      "name": "worker_zone",
      "coords": [
        [
          100,
          200
        ],
        [
          500,
          200
        ],
        [
          500,
          600
        ],
        [
          100,
          600
        ]
      ]
    },
    {
      "name": "site_zone",
      "coords": [
        [
          50,
          50
        ],
        [
          800,
          50
        ],
        [
          800,
          700
        ],
        [
          50,
          700
        ]
      ]
    }
  ],
  "rules": [
    {
      "type": "count_exceeded",
      "zone": "worker_zone",
      "required": [
        "forklift"
      ],
      "N": 1
    },
    {
      "type": "person_in_zone",
      "zone": "worker_zone",
      "required": [],
      "primary": "person"
    },
    {
      "type": "person_in_zone",
      "zone": "site_zone",
      "required": [
        "fire"
      ],
      "primary": "person"
    }
  ],
  "alert": {
    "severity": "critical",
    "message": "Fire detected on site!"
  },
  "cooldown_seconds": 10
}